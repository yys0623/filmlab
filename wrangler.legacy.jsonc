{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "film-lab",
  "main": "server/legacy-worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/locale"],
    "not_found_handling": "none"
  }
}
